# Public URL of the FastAPI backend (no trailing slash). Baked in at
# BUILD time (Next.js NEXT_PUBLIC_* convention) — a deployed environment
# must set this before/during the Railway build step, not only at
# runtime.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# pilot-deployment-ewise — comma-separated list of hostnames src/proxy.ts
# treats as the public marketing/legal domain (never the private app).
# Unset locally by construction (no local request ever arrives with a
# production Host header, so this never changes local dev behavior).
# Defaults to ewiseintelligence.com,www.ewiseintelligence.com when unset
# — see src/lib/public-routing.ts.
# NEXT_PUBLIC_MARKETING_HOSTS=ewiseintelligence.com,www.ewiseintelligence.com
