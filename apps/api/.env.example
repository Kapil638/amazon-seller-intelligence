# Copy to .env and adjust if needed.
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
PRODUCT_PROVIDER=rainforest
DEFAULT_MARKETPLACE=amazon.in
RAINFOREST_API_KEY=
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# OPENAI_VISION_MODEL=          # optional; defaults to OPENAI_MODEL. Does not change listing AI V1/V2.
# OPENAI_VISION_MAX_IMAGES=8
# OPENAI_VISION_ALLOWED_HOSTS=  # extra comma-separated hosts beyond m.media-amazon.com and placehold.co
# OPENAI_ADMIN_API_KEY=   # Admin API key for organization costs. Not OPENAI_API_KEY.
# OPENAI_ADMIN_KEY=       # accepted alias
# OPENAI_BUDGET_USD=100
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_OUTPUT_TOKENS=2500
# RAINFOREST_TIMEOUT_SECONDS=60
# RAINFOREST_CACHE_TTL_SECONDS=600
# RAINFOREST_SEARCH_CACHE_TTL_SECONDS=900
# RAINFOREST_ACCOUNT_CACHE_TTL_SECONDS=60
# REPORT_MAX_UPLOAD_BYTES=26214400
# PPC_WASTED_SPEND_MIN=500
# PPC_HIGH_ACOS=0.50
# PPC_LOW_CVR=0.05
# PPC_LOW_CVR_MIN_CLICKS=10
# BUSINESS_LOW_CONVERSION_MIN_SESSIONS=50
# BUSINESS_LOW_CONVERSION=0.05
# BULK_PRODUCT_PROVIDER=mock
# BULK_AI_PROVIDER=mock
# BULK_LIVE_PROVIDER_CALLS_ENABLED=false
# MAX_BULK_ASINS=100
# BULK_PRODUCT_CONCURRENCY=3
# PRODUCT_CACHE_TTL_SECONDS=86400
# AI_ANALYSIS_CACHE_TTL_SECONDS=604800
# PRODUCT_PROVIDER=mock
# PRODUCT_PROVIDER=amazon_public

# Persistence (FastAPI only — never expose these to Next.js)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
DEFAULT_ORGANIZATION_NAME=Development
# STORAGE_UPLOADS_BUCKET=seller-report-uploads
# STORAGE_GENERATED_BUCKET=generated-reports
# SIGNED_URL_TTL_SECONDS=300

# SP-API sandbox connectivity (12A.0). Never commit real values.
# Do not mix these with production / Draft LWA credentials.
SP_API_SANDBOX_ENABLED=false
SP_API_REGION=na
# SP_API_SANDBOX_BASE_URL=https://sandbox.sellingpartnerapi-na.amazon.com
# Optional production Sellers host override. Otherwise derived from SP_API_REGION.
# SP_API_PRODUCTION_BASE_URL=
# SP_API_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
SP_API_LWA_CLIENT_ID=
SP_API_LWA_CLIENT_SECRET=
SP_API_SANDBOX_REFRESH_TOKEN=
# SP_API_APPLICATION_NAME=EWise
# Sandbox application id. Not used for Connect Amazon when a production id is set.
# SP_API_APPLICATION_ID=
# Production / Draft application (Connect Amazon). Public application id is not a secret.
# SP_API_PRODUCTION_APPLICATION_ID=
# SP_API_PRODUCTION_LWA_CLIENT_ID=
# SP_API_PRODUCTION_LWA_CLIENT_SECRET=
# Optional consent origin override. Otherwise derived from marketplace.
# SP_API_OAUTH_CONSENT_BASE_URL=
# Registered Login with Amazon redirect URI. Must match Seller Partner Portal
# exactly. Sent to LWA on authorization-code exchange (12B.1C.5).
# SP_API_OAUTH_REDIRECT_URI=
# SP_API_OAUTH_STATE_TTL_SECONDS=600
# Draft Seller Central apps require version=beta on the consent URL.
# SP_API_CONSENT_VERSION_BETA=true
# AMAZON_SECRET_BACKEND=development
# production is a real backend (PostgreSQL + AES-256-GCM, see
# app/amazon/production_secrets.py) but fails closed until both keys
# below are set — never falls back to development.
# Local-only seller token file for DevelopmentSecretProvider. Not Postgres.
# Gitignored. Empty value keeps secrets in memory only (lost on API reload).
# AMAZON_DEVELOPMENT_SECRET_STORE=.data/amazon-development-secrets.json
#
# pilot-deployment-ewise, correction 1 — production SecretProvider master
# key material. JSON object {key_version: base64(32 raw AES-256 key
# bytes)}, e.g. '{"v1":"<base64 32-byte key>"}'. Railway encrypted
# variable only in any deployed environment — never committed, never in a
# persisted .env file outside local throwaway testing. Generate a key with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# AMAZON_SECRET_ENCRYPTION_KEYS=
# Which key_version above new writes use. Existing rows stay decryptable
# under whichever key_version they were written with.
# AMAZON_SECRET_ACTIVE_KEY_VERSION=v1

# pilot-deployment-ewise — deployed-environment-only settings. Every one
# below defaults to "unset" (existing local-dev behavior unchanged) and
# must be set explicitly on Railway. See
# docs/AI_HANDOVER/16_PILOT_DEPLOYMENT.md for the exact value per
# service.
#
# Starlette TrustedHostMiddleware allowlist. Empty/unset = no
# TrustedHostMiddleware registered at all (never "allow every host").
# ALLOWED_HOSTS='["api.ewiseintelligence.com"]'
#
# Per-process SQLAlchemy pool bounds — REQUIRED on any deployed
# environment sharing one remote Postgres pooler across several
# separate processes (API + 4 workers). Unset = SQLAlchemy's own
# defaults (pool_size=5, max_overflow=10) apply, which is what local
# dev/tests already exercise. The shared Supabase session-mode pooler
# used by this project has a hard pool_size=15 ceiling — budget
# accordingly across every concurrently-running service.
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=1
#
# Same-process worker self-watchdog (a separate OS thread, not another
# asyncio task) — the production equivalent of scripts/supervisor.py's
# own dev-only hung-worker detection, which has no equivalent once each
# worker is its own isolated Railway service. Defaults (600s / 30s) are
# usually fine as-is; override only with a specific reason.
# WORKER_WATCHDOG_STALE_AFTER_SECONDS=600
# WORKER_WATCHDOG_CHECK_INTERVAL_SECONDS=30
#
# pilot-deployment-ewise, correction 2 — API authentication. CORS/
# ALLOWED_HOSTS above are NOT an identity check. "disabled" (default) is
# current/local behavior (no auth middleware). "cloudflare_access"
# requires BOTH values below and validates a Cloudflare Access JWT
# (issuer/audience/signature/expiry) on every route except /health and
# the SP-API OAuth callback (app/core/cloudflare_access.py:PUBLIC_PATHS,
# not settings-configurable). Set on the api.ewiseintelligence.com
# Railway service only, after the matching Cloudflare Access application
# exists.
# API_AUTH_BACKEND=cloudflare_access
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUDIENCE=
